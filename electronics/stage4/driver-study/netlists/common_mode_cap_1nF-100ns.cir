IBload1 ret1 0 0
IBbridge1 br1 0 0
Ccommon1 ret1 0 1e-09 IC=0
Rret1 ret1 0 1e12
Rdr1 dr1 0 1e12
Ra1 a1 0 1e12
Mdriver1 dr1 gate1 sense1 sense1 FET W=1 L=1
Bamp1 0 state1 I={1e-9*(v(state1)>14.95 ? min(0,(max(-20000000,min(20000000,62831853.0717959*(v(set)-v(fb1))))-628.318530717959*v(state1))) : (v(state1)<0.05 ? max(0,(max(-20000000,min(20000000,62831853.0717959*(v(set)-v(fb1))))-628.318530717959*v(state1))) : (max(-20000000,min(20000000,62831853.0717959*(v(set)-v(fb1))))-628.318530717959*v(state1))))}
Cdom1 state1 0 1n IC=0.29998779296875

IBload0 ret0 0 0
IBbridge0 br0 0 0
Ccommon0 ret0 0 1e-09 IC=0
Rret0 ret0 0 1e12
Rdr0 dr0 0 1e12
Ra0 a0 0 1e12
Mdriver0 dr0 gate0 sense0 sense0 FET W=1 L=1
Bamp0 0 state0 I={1e-9*(v(state0)>14.95 ? min(0,(max(-20000000,min(20000000,62831853.0717959*(v(set)-v(fb0))))-628.318530717959*v(state0))) : (v(state0)<0.05 ? max(0,(max(-20000000,min(20000000,62831853.0717959*(v(set)-v(fb0))))-628.318530717959*v(state0))) : (max(-20000000,min(20000000,62831853.0717959*(v(set)-v(fb0))))-628.318530717959*v(state0))))}
Cdom0 state0 0 1n IC=0.29998779296875
Bout0 amp0 0 V={max(0.05,min(14.95,v(state0)))}
Dhi_a0 a0 hv CLAMP
Dlo_a0 0 a0 CLAMP
Dhi_br0 br0 hv CLAMP
Dlo_br0 0 br0 CLAMP
Dhi_dr0 dr0 hv CLAMP
Dlo_dr0 0 dr0 CLAMP
Vplus1 cp1 0 PWL(0 0 0.000425 0 0.000425001 3.3 0.000625 3.3 0.000625001 0)
Vminus1 cm1 0 PWL(0 0 0.000725 0 0.000725001 3.3 0.000925 3.3 0.000925001 0)
Brun1 run1 0 V={max(v(cp1),v(cm1))}
Boff1 off1 0 V={3.3-v(run1)}
Bfbctl1 fc1 0 V={v(run1)}
Bfboff1 foff1 0 V={3.3-v(fc1)}
S1_1 hv a1 cp1 0 BR
S4_1 dr1 br1 cp1 0 BR
S2_1 hv br1 cm1 0 BR
S3_1 dr1 a1 cm1 0 BR
Rpair1 a1 pol1 1000
Cpol1 pol1 ret1 2e-06 IC=0
